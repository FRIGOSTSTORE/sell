  function openPromo(){
    const el = document.getElementById('promoModal');
    el.classList.add('show');
    el.setAttribute('aria-hidden', 'false');
  }

  function closePromo(){
    const el = document.getElementById('promoModal');
    el.classList.remove('show');
    el.setAttribute('aria-hidden', 'true');
  }

  // Abrir automaticamente
  window.addEventListener('load', () => {
    setTimeout(openPromo, 800);
  });

  // Fechar ao clicar fora da caixa (somente no overlay)
  document.addEventListener('click', (e) => {
    const overlay = document.getElementById('promoModal');
    if (!overlay.classList.contains('show')) return;
    if (e.target && e.target.id === 'promoModal') closePromo();
  });

  // Fechar com ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePromo();
  });
</script>

